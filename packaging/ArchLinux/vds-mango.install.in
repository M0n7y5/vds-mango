# shellcheck shell=bash
_dkms_name="vds_hcd"
_dkms_version="@DKMS_VERSION@"
_install_service="/usr/share/vds-mango/install-service.sh"
_uninstall_service="/usr/share/vds-mango/uninstall-service.sh"

_is_systemd_running() {
	command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]
}

_is_udev_running() {
	command -v udevadm >/dev/null 2>&1 && [ -S /run/udev/control ]
}

# rmmod, not modprobe -r: on upgrade pacman's DKMS hook has already dropped the
# old module from the index, so modprobe cannot find the loaded module.
_unload_vds_hcd_module() {
	if [ -d "/sys/module/$_dkms_name" ]; then
		rmmod "$_dkms_name"
	fi
}

_dkms_remove_all_versions() {
	local ignore_errors=${1:-}
	local line
	local module
	local module_version
	local version

	while IFS= read -r line; do
		module_version=${line%%,*}
		module_version=${module_version%%:*}
		module=${module_version%%/*}
		version=${module_version#*/}
		case "$module" in
		"$_dkms_name" | "$_dkms_name"-*)
			if [ -n "$version" ] && [ "$version" != "$module_version" ]; then
				if ! dkms remove -m "$module" -v "$version" --all; then
					[ "$ignore_errors" = "--ignore-errors" ] || return 1
				fi
			fi
			;;
		esac
	done < <(dkms status 2>/dev/null || true)
}

_dkms_install_current() {
	_unload_vds_hcd_module || return 1
	_dkms_remove_all_versions
	_require_kernel_headers
	dkms add -m "$_dkms_name" -v "$_dkms_version"
	_build_dkms_module
	dkms install -m "$_dkms_name" -v "$_dkms_version"
}

_reload_udev_rules() {
	if _is_udev_running; then
		udevadm control --reload-rules || true
		udevadm trigger --subsystem-match=input || true
	fi
}

_install_vdsd_service() {
	if [ -x "$_install_service" ]; then
		"$_install_service" --enable --start
	fi
}

_stop_vdsd_service() {
	if [ -x "$_uninstall_service" ]; then
		"$_uninstall_service" --stop || true
	fi
}

_reload_systemd() {
	if _is_systemd_running; then
		systemctl daemon-reload || true
	fi
}

_ensure_vds_group() {
	getent group vds >/dev/null 2>&1 || groupadd --system vds
}

_require_kernel_headers() {
	local kernel_release
	local message

	kernel_release=$(uname -r)
	if [ -d "/lib/modules/$kernel_release/build" ]; then
		return 0
	fi
	message="vds-mango: kernel headers for $kernel_release are not installed;"
	message="$message install its headers package (e.g. linux-headers), then run:"
	message="$message sudo dkms install $_dkms_name/$_dkms_version"
	echo "$message" >&2
	exit 1
}

_build_dkms_module() {
	local message

	if dkms build -m "$_dkms_name" -v "$_dkms_version"; then
		return 0
	fi
	message="vds-mango: kernel module build failed, see"
	message="$message /var/lib/dkms/$_dkms_name/$_dkms_version/build/make.log"
	echo "$message" >&2
	exit 1
}

_warn_legacy_config_db() {
	local db_path="/var/lib/vds/vdsd.db"
	local message

	[ -f "$db_path" ] || return 0
	grep -qv '"profile"' "$db_path" || return 0
	message="vds-mango: $db_path predates 0.3.0 and cannot be read;"
	message="$message delete it and re-register controllers with vdsctl attach"
	echo "$message" >&2
}

_print_next_steps_notice() {
	cat <<'NOTICE'
vds-mango: vdsd.service is enabled and started, udev rule installed.
Next steps:
  1. sudo /usr/share/vds-mango/override-bluetoothd.sh disable-input --restart
     note: Bluetooth keyboards and mice stop working while disabled
  2. In bluetoothctl: pair <address> then trust <address> (hold Create and PS
     until the light bar blinks to enter pairing mode)
  3. sudo usermod -aG vds $USER, then log out and back in to use vdsctl
     without sudo
  4. vdsctl list-targets, then vdsctl attach <address>, then press the PS
     button on the controller
  5. Audio: copy
     /usr/share/doc/vds-mango/examples/99-vds-dualsense-wireplumber.conf
     to ~/.config/wireplumber/wireplumber.conf.d/ and set the pro-audio card
     profile (see the README)
Log: /var/log/vdsd.log
Full guide: /usr/share/doc/vds-mango/README.md
NOTICE
}

post_install() {
	_dkms_install_current
	_reload_udev_rules
	_ensure_vds_group
	_install_vdsd_service
	_print_next_steps_notice
}

pre_upgrade() {
	_stop_vdsd_service
	_unload_vds_hcd_module || return 1
	_dkms_remove_all_versions --ignore-errors
}

post_upgrade() {
	_dkms_install_current
	_reload_udev_rules
	_ensure_vds_group
	_warn_legacy_config_db
	_install_vdsd_service
	_print_next_steps_notice
}

pre_remove() {
	if [ -x "$_uninstall_service" ]; then
		"$_uninstall_service" --stop --disable || true
	fi
	_unload_vds_hcd_module || return 1
	_dkms_remove_all_versions --ignore-errors
}

post_remove() {
	_reload_systemd
	_reload_udev_rules
}
