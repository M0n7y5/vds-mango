# shellcheck shell=bash
_override_bluetoothd="/usr/share/vds-mango/override-bluetoothd.sh"
_install_service="/usr/share/vds-mango/install-service.sh"
_uninstall_service="/usr/share/vds-mango/uninstall-service.sh"

_is_systemd_running() {
	command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]
}

_is_udev_running() {
	command -v udevadm >/dev/null 2>&1 && [ -S /run/udev/control ]
}

_reload_udev_rules() {
	if _is_udev_running; then
		udevadm control --reload-rules || true
		udevadm trigger --subsystem-match=input || true
	fi
}

_install_vdsd_service() {
	if [ -x "$_install_service" ]; then
		"$_install_service" --enable --start
	fi
}

_stop_vdsd_service() {
	if [ -x "$_uninstall_service" ]; then
		"$_uninstall_service" --stop || true
	fi
}

_reload_systemd() {
	if _is_systemd_running; then
		systemctl daemon-reload || true
	fi
}

_ensure_vds_group() {
	getent group vds >/dev/null 2>&1 || groupadd --system vds
}

_warn_legacy_config_db() {
	local db_path="/var/lib/vds/vdsd.db"
	local message

	[ -f "$db_path" ] || return 0
	grep -qv '"profile"' "$db_path" || return 0
	message="vds-mango: $db_path predates 0.3.0 and cannot be read;"
	message="$message delete it and re-register controllers with vdsctl attach"
	echo "$message" >&2
}

# The setup wizard switches bluetoothd's input plugin off. Left behind, that
# keeps Bluetooth keyboards and mice dead after the package is gone, and the
# script that undoes it goes with the package.
_restore_bluetooth_input() {
	_is_systemd_running || return 0
	[ -x "$_override_bluetoothd" ] || return 0
	systemctl show -p ExecStart --value bluetooth.service 2>/dev/null |
		grep -q -- '--noplugin=input' || return 0
	if "$_override_bluetoothd" --restart enable-input >/dev/null; then
		echo "vds-mango: Bluetooth input restored; bluetoothd was restarted."
	else
		echo "vds-mango: could not restore Bluetooth input; remove the" \
			"--noplugin=input drop-in under" \
			"/etc/systemd/system/bluetooth.service.d/ by hand." >&2
	fi
}

_print_next_steps_notice() {
	cat <<'NOTICE'
vds-mango: vdsd.service is enabled and started.
Open vDS Mango from the application menu (or run vds-mango) to finish setup
and add a controller.
Log: /var/log/vdsd.log
Command-line setup: /usr/share/doc/vds-mango/README.md
NOTICE
}

post_install() {
	_reload_udev_rules
	_ensure_vds_group
	_install_vdsd_service
	_print_next_steps_notice
}

pre_upgrade() {
	_stop_vdsd_service
}

post_upgrade() {
	_reload_udev_rules
	_ensure_vds_group
	_warn_legacy_config_db
	_install_vdsd_service
	_print_next_steps_notice
}

pre_remove() {
	if [ -x "$_uninstall_service" ]; then
		"$_uninstall_service" --stop --disable || true
	fi
	_restore_bluetooth_input
}

post_remove() {
	_reload_systemd
	_reload_udev_rules
}
