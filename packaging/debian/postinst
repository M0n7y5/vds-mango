#!/bin/sh
set -e

DKMS_NAME="vds_hcd"
DKMS_VERSION="@DKMS_VERSION@"
INSTALL_SERVICE="/usr/share/vds/install-service.sh"

is_udev_running() {
	command -v udevadm >/dev/null 2>&1 && [ -S /run/udev/control ]
}

unload_vds_hcd_module() {
	if [ -d "/sys/module/$DKMS_NAME" ]; then
		modprobe -r "$DKMS_NAME"
	fi
}

remove_all_dkms_versions() {
	dkms status 2>/dev/null |
	while IFS= read -r line; do
		module_version=${line%%,*}
		module_version=${module_version%%:*}
		module=${module_version%%/*}
		version=${module_version#*/}
		case "$module" in
		"$DKMS_NAME" | "$DKMS_NAME"-*)
			if [ -n "$version" ] && [ "$version" != "$module_version" ]; then
				dkms remove -m "$module" -v "$version" --all
			fi
			;;
		esac
	done
}

print_next_steps_notice() {
	cat <<'NOTICE'
vds: vdsd.service is enabled and started, udev rule installed.
Next steps:
  1. sudo /usr/share/vds/override-bluetoothd.sh disable-input --restart
     note: Bluetooth keyboards and mice stop working while disabled
  2. In bluetoothctl: pair <address> then trust <address> (hold Create and PS
     until the light bar blinks to enter pairing mode)
  3. sudo usermod -aG vds $USER, then log out and back in to use vdsctl
     without sudo
  4. vdsctl list-targets, then vdsctl attach <address>, then press the PS
     button on the controller
  5. Audio: copy /usr/share/doc/vds/examples/99-vds-dualsense-wireplumber.conf
     to ~/.config/wireplumber/wireplumber.conf.d/ and set the pro-audio card
     profile (see README-LINUX)
Log: /var/log/vdsd.log
Full guide: /usr/share/doc/vds/README-LINUX.md
NOTICE
}

ensure_vds_group() {
	getent group vds >/dev/null 2>&1 || groupadd --system vds
}

require_kernel_headers() {
	kernel_release=$(uname -r)
	if [ -d "/lib/modules/$kernel_release/build" ]; then
		return 0
	fi
	message="vds: kernel headers for $kernel_release are not installed;"
	message="$message install linux-headers-$kernel_release (Debian) or"
	message="$message linux-headers (Arch), then run:"
	message="$message sudo dkms install $DKMS_NAME/$DKMS_VERSION"
	echo "$message" >&2
	exit 1
}

build_dkms_module() {
	if dkms build -m "$DKMS_NAME" -v "$DKMS_VERSION"; then
		return 0
	fi
	message="vds: kernel module build failed, see"
	message="$message /var/lib/dkms/$DKMS_NAME/$DKMS_VERSION/build/make.log"
	echo "$message" >&2
	exit 1
}

warn_legacy_config_db() {
	db_path="/var/lib/vds/vdsd.db"
	[ -f "$db_path" ] || return 0
	grep -qv '"profile"' "$db_path" || return 0
	message="vds: $db_path predates 0.3.0 and cannot be read;"
	message="$message delete it and re-register controllers with vdsctl attach"
	echo "$message" >&2
}

case "$1" in
configure)
	unload_vds_hcd_module
	remove_all_dkms_versions
	require_kernel_headers
	dkms add -m "$DKMS_NAME" -v "$DKMS_VERSION"
	build_dkms_module
	dkms install -m "$DKMS_NAME" -v "$DKMS_VERSION"

	if is_udev_running; then
		udevadm control --reload-rules || true
		udevadm trigger --subsystem-match=input || true
	fi
	ensure_vds_group
	warn_legacy_config_db
	if [ -x "$INSTALL_SERVICE" ]; then
		"$INSTALL_SERVICE" --enable --start
	fi
	print_next_steps_notice
	;;
esac

exit 0
