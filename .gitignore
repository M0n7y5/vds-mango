!/src/
!/src/**/
!/src/**/*.c
!/src/**/*.cc
!/src/**/*.cpp
!/src/**/*.cxx
!/src/**/*.h
!/src/**/*.hh
!/src/**/*.hpp
!/src/**/*.hxx

