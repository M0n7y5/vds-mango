*
!/.gitignore

!/CMakeLists.txt
!/LICENSE
!/README.md

!/.github/
!/.github/workflows/
!/.github/workflows/*.yaml

!/cmake/
!/cmake/*.cmake

!/data/
!/data/*.conf
!/data/*.desktop
!/data/*.in
!/data/*.rules
!/data/icons/
!/data/icons/*.svg
!/data/animations/
!/data/animations/*.json

!/docs/
!/docs/*.html
!/docs/*.png
!/docs/*.svg
!/docs/sitemap.xml

!/include/
!/include/**/
!/include/**/*.h

!/packaging/
!/packaging/ArchLinux/
!/packaging/ArchLinux/*.in
!/packaging/ArchLinux/*.install
!/packaging/ArchLinux/PKGBUILD
!/packaging/ArchLinux/*.sh

!/scripts/
!/scripts/*.sh

!/src/
!/src/**/
!/src/**/*.c
!/src/**/*.cc
!/src/**/*.cpp
!/src/**/*.cxx
!/src/**/*.h
!/src/**/*.hh
!/src/**/*.hpp
!/src/**/*.hxx

!/tests/
!/tests/*.cc
!/tests/*.hh
